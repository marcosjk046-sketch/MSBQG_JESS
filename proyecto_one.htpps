<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Para_jessica</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            background: linear-gradient(135deg, #0f0f0f, #24123d);
            color: white;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            overflow: hidden; /* Evita barras de desplazamiento si el botón crece mucho */
            position: relative;
        }

        .card {
            text-align: center;
            background: rgba(255,255,255,0.06);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 0 30px rgba(127,92,255,0.4);
            max-width: 90%;
            z-index: 10;
        }

        h1 {
            color: #c7a6ff;
            margin-bottom: 25px;
        }

        .buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-top: 25px;
            flex-wrap: wrap;
        }

        button {
            border: none;
            border-radius: 30px;
            padding: 14px 28px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        #si {
            background: #7f5cff;
            color: white;
            z-index: 20; /* Mantiene el botón Sí accesible */
        }

        #no {
            background: #333;
            color: #ddd;
            z-index: 10;
        }

        .credits {
            position: absolute;
            bottom: 15px;
            right: 20px;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.5);
            z-index: 30;
            pointer-events: none;
            text-align: right;
            line-height: 1.3;
        }
    </style>
</head>
<body>

<div class="card">
    <h1>¿Querés intentar algo conmigo?</h1>
    <div class="buttons">
        <button id="si" onclick="aceptar()">Sí</button>
        <button id="no" onclick="rechazar()">No</button>
    </div>
</div>

<div class="credits">
    From: Marcos<br>
    To: Jessica
</div>

<script>
    let escala = 1;
    let textosNo = [
        "¿segura?",
        "pensalo bien",
        "dale una oportunidad",
        "no es tan mala idea",
        "última chance...",
        "de verdad no?",
        "mira lo grande que está el SÍ",
        "ya casi no podés apretar acá",
        "insisto...",
        "no seas mala 🥺"
    ];
    let intentos = 0;

    function rechazar() {
        escala += 0.35;
        document.getElementById("si").style.transform = `scale(${escala})`;

        if (intentos < textosNo.length) {
            document.getElementById("no").innerText = textosNo[intentos];
        } else {
            document.getElementById("no").innerText = `No #${intentos + 1} (imposible esquivar el SÍ)`;
        }
        intentos++;
    }

    function aceptar() {
        document.body.innerHTML = `
            <div style="
                color:white;
                text-align:center;
                font-family:'Segoe UI', sans-serif;">
                <h1 style="color:#b18cff;">Sabía que sí 💜</h1>
                <p>Prometo cuidarte y hacer que valga la pena.</p>
            </div>
            <div class="credits">
                From: Marcos<br>
                To: Jessica
            </div>
        `;
    }
</script>

</body>
</html>
